# NajiyaDaily — Environment Variables

# Site
NEXT_PUBLIC_SITE_URL=https://www.najiyadaily.com

# Supabase — get these from supabase.com → Project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin dashboard password (you choose this)
ADMIN_SECRET=choose-a-strong-password

# Netlify revalidation
REVALIDATE_SECRET=nd2026secret

# Affiliate
NEXT_PUBLIC_BOOKING_PARTNER_ID=101867344
NEXT_PUBLIC_AMAZON_TAG=najiyadaily-20

# GitHub Actions will also need these as repository secrets:
# ANTHROPIC_API_KEY
# PEXELS_API_KEY
# UNSPLASH_ACCESS_KEY
# NEWS_API_KEY
# NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY
# REVALIDATE_SECRET
